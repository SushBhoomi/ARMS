{

  "TokenSettings": {
    "AccessTokenSecret": "your_access_token_secret_key_here",
    "RefreshTokenSecret": "your_refresh_token_secret_key_here"
  },
  "Ldap": {
    "Path": "ldap.forumsys.com",
    "Port": 389,
    "UserDomainName": "example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"

    }
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    //Verbose/Debug/Information/Warning/Error/Fatal
    "MinimumLevel": "Warning",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          // Keep maximum 70 files = around 2 months.
          "retainedFileCountLimit": 70
        }
      }
    ]
  }
}
